# Copia este archivo como app/.env y rellena tus valores (o configúralos como "Variables" en GitHub Actions).

# Servidor online (WebSocket seguro). Vacío = modo online desactivado.
VITE_SERVER_URL=wss://tu-servidor.onrender.com

# AdMob — IDs de bloques de anuncios (https://admob.google.com). Si se dejan vacíos se usan los de PRUEBA.
VITE_ADMOB_ANDROID_BANNER=
VITE_ADMOB_ANDROID_INTERSTITIAL=
VITE_ADMOB_ANDROID_REWARDED=
VITE_ADMOB_IOS_BANNER=
VITE_ADMOB_IOS_INTERSTITIAL=
VITE_ADMOB_IOS_REWARDED=
# Pon "false" solo en la versión publicada con tus IDs reales
VITE_ADMOB_TESTING=true

# RevenueCat — claves públicas de la app (https://app.revenuecat.com → Project → API keys)
VITE_REVENUECAT_ANDROID_KEY=
VITE_REVENUECAT_IOS_KEY=

# URL pública de tu política de privacidad (obligatoria en las tiendas)
VITE_PRIVACY_URL=https://tu-web.com/privacidad
VITE_TERMS_URL=https://tu-web.com/terminos
